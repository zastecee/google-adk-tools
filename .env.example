# Copy this file to .env and fill in your values

# ADK / Google model
ADK_MODEL=gemini-2.0-flash
GOOGLE_GENAI_API_KEY=your_google_ai_studio_key_here

# LiteLLM / Bedrock proxy
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=test-key
LITELLM_MODEL=bedrock-claude

AWS_REGION=eu-west-1
AWS_PROFILE=your-aws-profile
BEDROCK_MODEL_ID=your-bedrock-model-id

# Module 04_01 only — Oracle database credentials
ORACLE_CONNECTION_STRING=your-oracle-host:1521/ORCL
ORACLE_USERNAME=your-oracle-username
ORACLE_PASSWORD=your-oracle-password
